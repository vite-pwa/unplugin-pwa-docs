{
  "name": "unplugin-pwa-docs",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.9.1",
  "description": "PWA Ecosystem Documentation",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "maintainers": [
    "userquin <userquin@gmail.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/unplugin-pwa-docs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/unplugin-pwa-docs.git"
  },
  "bugs": "https://github.com/vite-pwa/unplugin-pwa-docs/issues",
  "keywords": [
    "react",
    "pwa",
    "vue",
    "vitepress",
    "preact",
    "svelte",
    "sveltekit",
    "workbox",
    "solidjs",
    "vite",
    "vite-plugin",
    "astro",
    "astro-integration",
    "iles",
    "nuxt",
    "nuxt module"
  ],
  "scripts": {
    "generate-avatars": "node scripts/prepare-avatars.mts",
    "generate-og-image": "node scripts/prepare-og-image.mts",
    "gen-api-pages": "node scripts/gen-api-pages.ts",
    "dev": "pnpm gen-api-pages && vitepress dev",
    "build": "pnpm gen-api-pages && vitepress build",
    "preview": "nr build && vitepress serve",
    "https": "nr build && serve .vitepress/dist",
    "lint": "eslint .",
    "lint:fix": "nr lint --fix",
    "generate-pwa-icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@vueuse/core": "catalog:utils",
    "@vueuse/shared": "catalog:utils",
    "vue": "catalog:vue"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@antfu/ni": "catalog:utils",
    "@types/node": "catalog:types",
    "@unplugin-pwa/core": "catalog:pwa",
    "@unplugin-pwa/inspector": "catalog:pwa",
    "@unplugin-pwa/types": "catalog:pwa",
    "@unplugin-pwa/vite": "catalog:pwa",
    "@vite-pwa/assets-generator": "catalog:pwa",
    "@vite-pwa/workbox-build": "catalog:pwa",
    "@vite-pwa/workbox-swkit": "catalog:pwa",
    "@vite-pwa/workbox-types": "catalog:pwa",
    "@vite-pwa/workbox-window": "catalog:pwa",
    "@vitejs/plugin-vue": "catalog:vue",
    "eslint": "catalog:eslint",
    "eslint-plugin-antfu": "catalog:eslint",
    "https-localhost": "catalog:utils",
    "sharp": "catalog:utils",
    "taze": "catalog:utils",
    "typescript": "catalog:typescript",
    "unocss": "catalog:utils",
    "unplugin-vue-components": "catalog:utils",
    "vite": "catalog:vite",
    "vitepress": "catalog:utils",
    "vitepress-plugin-group-icons": "catalog:utils",
    "vitepress-plugin-llms": "catalog:utils"
  }
}
